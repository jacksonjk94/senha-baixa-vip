# .env do serviço telegram-mtproto (NÃO commitar valores reais)
# Obtidos em https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Porta interna do serviço (o compose publica em 127.0.0.1:PORTA)
TELEGRAM_MTPROTO_PORT=3037
# Idêntico ao TELEGRAM_MTPROTO_SERVICE_TOKEN do .env do Laravel
# Gere com: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
TELEGRAM_MTPROTO_SERVICE_TOKEN=troque_por_token_aleatorio_64_hex
# Fuso para os logs
TZ=America/Sao_Paulo
