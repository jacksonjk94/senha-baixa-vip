# .env da VPS — copie para `.env` na VPS e preencha os valores reais.
#   cp .env.vps.example .env && nano .env
# NUNCA commite o `.env` com valores reais.

APP_NAME="SenhaBaixa VIP"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://srv836395.hstgr.cloud
APP_KEY=base64:COLE_AQUI_O_MESMO_APP_KEY_DO_ENV_ATUAL

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# MySQL (container `db` deste compose)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=agenda_facil
DB_USERNAME=agenda
DB_PASSWORD=TROQUE_POR_SENHA_FORTE

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

# Telegram (login por código via conta)
TELEGRAM_BOT_NAME="AgendaFacil26_bot"
TELEGRAM_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# O mtproto continua público e inalterado:
TELEGRAM_MTPROTO_URL=https://srv836395.hstgr.cloud
TELEGRAM_MTPROTO_SERVICE_TOKEN=MESMO_VALOR_DO_ENV_DO_MTPROTO_NA_VPS

# Chave do worker de disparos (cron interno → Laravel)
N8N_WORKER_SECRET=TROQUE_POR_STRING_LONGA_ALEATORIA
DISPARO_ANTECIPACAO_SEGUNDOS=65

TZ=America/Sao_Paulo
