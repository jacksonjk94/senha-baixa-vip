{
    "version": 2,
    "framework": null,
    "outputDirectory": "public",
    "functions": {
        "api/**/*.php": {
            "runtime": "vercel-php@0.6.2",
            "memory": 1024,
            "maxDuration": 10
        }
    },
    "routes": [
        {
            "src": "/favicon.svg",
            "dest": "/public/favicon.svg"
        },
        {
            "src": "/assets/images(.*)",
            "dest": "/public/assets/images/"
        },
        {
            "src": "/Terminal.php",
            "dest": "/public/Terminal.php"
        },
        {
            "src": "/build(.*)",
            "dest": "/public/build/"
        },
        {
            "src": "/storage(.*)",
            "dest": "/public/storage/"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_ENV": "local",
        "APP_DEBUG": "true",
        "APP_URL": "https://senhabaixavip.vercel.app",

        "APP_CONFIG_CACHE": "/tmp/config.php",
        "APP_EVENTS_CACHE": "/tmp/events.php",
        "APP_PACKAGES_CACHE": "/tmp/packages.php",
        "APP_ROUTES_CACHE": "/tmp/routes.php",
        "APP_SERVICES_CACHE": "/tmp/services.php",
        "VIEW_COMPILED_PATH": "/tmp",

        "APP_MAINTENANCE_DRIVER": "cache",
        "LOG_CHANNEL": "stderr",
        "LOG_PATH": "/tmp/laravel.log",
        "QUEUE_CONNECTION": "sync",
        "SESSION_DRIVER": "database",
        "SESSION_LIFETIME": "120",
        "DISPARO_ANTECIPACAO_SEGUNDOS": "0"
    },
    "crons": [{
        "path": "/api/n8n/disparos/processar",
        "schedule": "* * * * *"
    }]
}
